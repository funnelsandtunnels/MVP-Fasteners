{
  "name": "orion-rfq-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Localhost MVP: LLM-powered RFQ email processing for fastener distributors",
  "scripts": {
    "seed": "node server/seed/run.js",
    "server": "node --watch server/index.js",
    "client": "vite client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "vite build client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.67.3",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
